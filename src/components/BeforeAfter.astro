---
/**
 * Före/efter-jämförelse. Dra reglaget (eller använd piltangenterna).
 * Användning: <BeforeAfter before={img} after={img} alt="Beskrivning" />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  alt: string;            // Vad bilden visar, t.ex. "Motorhuv på svart Volvo"
  placeholder?: boolean;  // Visa "Platshållarbild"-märkning
  sizes?: string;
}
const { before, after, alt, placeholder = false, sizes = '(min-width: 1240px) 1200px, 100vw' } = Astro.props;
const id = `ba-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="ba" data-ba style="--pos: 50%">
  <div class="ba__stage">
    <Image src={after} alt={`Efter: ${alt}`} widths={[480, 800, 1200, 1600]} sizes={sizes} format="webp" class="ba__img" />
    <div class="ba__before">
      <Image src={before} alt={`Före: ${alt}`} widths={[480, 800, 1200, 1600]} sizes={sizes} format="webp" class="ba__img" />
    </div>
    <span class="ba__label ba__label--before" aria-hidden="true">Före</span>
    <span class="ba__label ba__label--after" aria-hidden="true">Efter</span>
    <div class="ba__handle" aria-hidden="true"><span><Icon name="slider" size={22} /></span></div>
    {placeholder && <span class="ph-badge">Platshållarbild</span>}
    <label class="sr-only" for={id}>Jämför före och efter</label>
    <input class="ba__range" id={id} type="range" min="0" max="100" value="50" step="1" data-ba-range />
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('[data-ba-range]')!;
    const update = () => {
      el.style.setProperty('--pos', `${range.value}%`);
      range.setAttribute('aria-valuetext', `${range.value} procent före`);
    };
    range.addEventListener('input', update);
    update();

    // Dra var som helst i bilden (mus + touch). Reglaget används för tangentbord.
    const stage = el.querySelector<HTMLElement>('.ba__stage')!;
    const setFromX = (x: number) => {
      const r = stage.getBoundingClientRect();
      range.value = String(Math.round(Math.min(100, Math.max(0, ((x - r.left) / r.width) * 100))));
      update();
    };
    let dragging = false;
    stage.addEventListener('pointerdown', (e) => {
      dragging = true;
      stage.setPointerCapture(e.pointerId);
      setFromX(e.clientX);
    });
    stage.addEventListener('pointermove', (e) => dragging && setFromX(e.clientX));
    const stop = () => (dragging = false);
    stage.addEventListener('pointerup', stop);
    stage.addEventListener('pointercancel', stop);
  });
</script>

<style>
  .ba { margin: 0; }
  .ba__stage {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    aspect-ratio: 16 / 10;
    background: var(--surface);
    user-select: none;
    touch-action: pan-y;
  }
  .ba__stage :global(.ba__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba__label {
    position: absolute;
    bottom: 1rem;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.65);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .ba__label--before { left: 1rem; }
  .ba__label--after { right: 1rem; color: var(--accent-hi); }
  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 18px rgb(46 139 255 / 0.9);
    pointer-events: none;
  }
  .ba__handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff;
    color: var(--bg);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.5);
  }
  /* Osynligt reglage – ger tangentbordsstyrning och skärmläsarstöd */
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .ba__stage { cursor: ew-resize; }
  .ba__stage:has(.ba__range:focus-visible) .ba__handle span {
    outline: 3px solid var(--accent-hi);
    outline-offset: 3px;
  }
</style>
