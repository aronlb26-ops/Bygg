# Kopiera till .env och fyll i. I Netlify/Vercel: lägg in samma variabler
# under "Environment variables".

# Riktig domän – används för sitemap, canonical-länkar och Open Graph.
SITE_URL=https://example.com

# Formulär: "formspree" eller "netlify"
PUBLIC_FORM_PROVIDER=formspree
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/DITT_ID

# Valfritt: extern bokning (Bokadirekt, Calendly …). Om satt leder alla
# "Boka tid"-knappar dit i stället för till /boka/.
PUBLIC_BOOKING_URL=
